# Alchemy
NEXT_PUBLIC_ALCHEMY_ID=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Telcoin API key
TELCOIN_API_KEY=

# Datadog
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=

# TELx Backend
TELX_BACKEND_SECRET_KEY=

# Uniswap api key
UNISWAP_API_KEY=

# Site origin, sent as the Origin header on server-side Alchemy calls
NEXT_PUBLIC_ORIGIN=

# Build identifier, used to cache-bust OG images
NEXT_PUBLIC_BUILD_ID=

# Preview frontdoor. When set to "user:password" every page requires HTTP Basic auth.
# Set this in Vercel for the Preview environment only; leave empty for production and local dev.
PREVIEW_BASIC_AUTH=
