# Alchemy. Server-only: the browser reads chain data through /api/rpc/[chain], which attaches this key.
ALCHEMY_ID=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Telcoin API key
TELCOIN_API_KEY=

# Datadog
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=

# Pool data store (Upstash Redis). Set by the Vercel storage integration; read by /api/pools, the crons and /api/health.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The Graph gateway key. Server-only: the pool data crons query the subgraphs with it.
GRAPH_STUDIO_KEY=

# Bearer secret for /api/cron/*. Vercel sends it on every cron run; the routes refuse all requests when it is unset.
CRON_SECRET=

# Bearer secret for /api/health, for an external monitor. The route refuses all requests when it is unset.
HEALTH_CHECK_SECRET=

# Site origin, sent as the Origin header on server-side Alchemy calls
NEXT_PUBLIC_ORIGIN=

# Build identifier, used to cache-bust OG images
NEXT_PUBLIC_BUILD_ID=

# Preview frontdoor. When set to "user:password" every page requires HTTP Basic auth.
# Set this in Vercel for the Preview environment only and scope it to the branch you share,
# so ordinary PR previews stay open. Leave it empty for production and local dev.
# A successful login is remembered in a cookie for 30 days per hostname; changing the value logs everyone out.
PREVIEW_BASIC_AUTH=
